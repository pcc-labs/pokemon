# ROM files (legally obtained, not for distribution)
rom/

# Emulator save data
*.ram
*.sav
*.state

# Screenshot output
frames/

# Observer memory output (per-run observations + watermark)
pokedex/memory/

# Plans (ephemeral working artifacts, never commit)
docs/plans/

# Agent working memory (ephemeral per-run notes)
notes.md

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
.venv/

# Environment / secrets
.env
*.key

# Claude Code (user-specific)
.claude/

# Test artifacts
.coverage
.pytest_cache/

# Pokedex session logs (log7+ are local-only run artifacts)
pokedex/log[7-9]*.md
pokedex/log1[0-9]*.md
pokedex/log2[0-9]*.md
